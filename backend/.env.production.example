# KHWWC Production Environment Configuration
# Copy this file to .env on the production server and fill in the actual values.
# NEVER commit the production .env file to version control.

APP_NAME="KHWWC Welfare System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app1.kirinyagahealthcareworkerswelfare.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database — MySQL (production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kirinyag_health
DB_USERNAME=kirinyag_Deno
DB_PASSWORD=Neibas2022
DB_SOCKET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.kirinyagahealthcareworkerswelfare.co.ke

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=
JWT_ISSUER=khcww-welfare
JWT_TTL=3600
REFRESH_TTL=2592000

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kirinyagahealthcareworkerswelfare.co.ke"
MAIL_FROM_NAME="KHCWWC Welfare"

# Co-operative Bank Integration
COOP_ENVIRONMENT=production
COOP_ENABLE_REAL_CALLS=true
COOP_CONSUMER_KEY=
COOP_CONSUMER_SECRET=
COOP_TOKEN_URL=https://openapi.co-opbank.co.ke/token
COOP_PRODUCTION_BASE_URL=https://api.co-opbank.co.ke
COOP_SANDBOX_BASE_URL=https://openapi.co-opbank.co.ke
COOP_ACCOUNT_NUMBER=
COOP_ACCOUNT_NAME="KIRINYAGA HEALTH CARE"
COOP_USER_ID=KirinyagaHealthCare
COOP_OPERATOR_CODE=KIRINYAGA
COOP_CALLBACK_BASE_URL=https://app1.kirinyagahealthcareworkerswelfare.co.ke/api/banking/coop/callback
COOP_TOKEN_REFRESH_BUFFER=60
COOP_API_TIMEOUT=30
COOP_CONNECT_TIMEOUT=10
COOP_CALLBACK_VERIFY_SIGNATURE=false
COOP_CALLBACK_SIGNATURE_SECRET=
COOP_WEBHOOK_IPS=

# SMS Gateway (optional — gracefully degrades if not configured)
SMS_GATEWAY=log
SMS_FROM=KHCWWC
SMS_API_KEY=
SMS_API_URL=

# Frontend
VITE_APP_NAME="KHWWC Welfare System"

# CORS (production domain)
CORS_ALLOWED_ORIGINS=https://app1.kirinyagahealthcareworkerswelfare.co.ke
